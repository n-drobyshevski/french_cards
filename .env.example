# Supabase (leave empty to run fully local, without login or sync)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The only email allowed to sign in
ALLOWED_EMAIL=
# Claude API key for suggestions, screenshot extraction and sorting
ANTHROPIC_API_KEY=
# Shared secret for the Vercel cron job that keeps Supabase awake
CRON_SECRET=
