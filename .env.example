# Supabase (leave both empty to run fully local: no login, no sync, /api/ai/* only outside production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The only email allowed to sign in and to use /api/ai/* (checked on the server; empty = nobody)
ALLOWED_EMAIL=
# Optional: the same address for the login screen, so a wrong address is refused before a code is sent
NEXT_PUBLIC_ALLOWED_EMAIL=

# Claude API key for suggestions, screenshot extraction and sorting (server only)
ANTHROPIC_API_KEY=
# Optional: model for screenshot extraction (e.g. claude-sonnet-5-5); empty = claude-haiku-5-5
AI_MODEL_EXTRACT=

# Shared secret for the daily Vercel cron (/api/cron/ping) that keeps Supabase awake; Vercel sends it as a Bearer token
CRON_SECRET=

# Claude connector (docs/CONNECTOR.md). All three must be set or /api/mcp/* answers 404.
# Secret path segment of the connector URL, at least 32 characters: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
MCP_SECRET=
# Supabase secret key (sb_secret_…, server only): the connector has no user session, so it bypasses RLS
SUPABASE_SECRET_KEY=
# Supabase Auth user id whose words the connector reads and writes (every query filters on it)
MCP_USER_ID=
# Optional: IANA time zone for «сегодня» in study_summary (the study day starts at 04:00); empty = Europe/Paris
MCP_TIMEZONE=
